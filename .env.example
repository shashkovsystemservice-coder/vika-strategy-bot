# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ALLOWED_TELEGRAM_USER_ID=
MAX_VOICE_SECONDS=600

# Gemini
GEMINI_API_KEY=
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# GitHub answer storage
GITHUB_WRITE_TOKEN=
GITHUB_REPO=shashkovsystemservice-coder/vika-strategy-bot
GITHUB_BRANCH=main
GITHUB_ANSWERS_PATH=data/answers.json

# One-time webhook setup protection
SETUP_SECRET=
# Optional. Vercel normally provides VERCEL_PROJECT_PRODUCTION_URL automatically.
PUBLIC_BASE_URL=
